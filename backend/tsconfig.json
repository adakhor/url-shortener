{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "types": ["node", "jest"],

    "sourceMap": true,

    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}